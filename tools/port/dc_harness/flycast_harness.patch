diff --git a/shell/libretro/libretro.cpp b/shell/libretro/libretro.cpp
index c5f781a..ca3efed 100644
--- a/shell/libretro/libretro.cpp
+++ b/shell/libretro/libretro.cpp
@@ -3925,3 +3925,45 @@ void os_notify(const char *msg, int durationMs, const char *details)
 	retromsg.frames = durationMs / 17;
 	environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE, &retromsg);
 }
+
+/* ---- headless debug helpers (Vivid Dolls port harness) ---- */
+extern "C" RETRO_API void retro_dbg_get_regs(uint32_t *out)
+{
+	Sh4Context &c = Sh4cntx;
+	for (int i = 0; i < 16; i++)
+		out[i] = c.r[i];
+	out[16] = c.pc; out[17] = c.pr; out[18] = c.sr.getFull(); out[19] = c.gbr;
+	out[20] = c.vbr; out[21] = c.spc; out[22] = c.ssr; out[23] = c.fpscr.full;
+	out[24] = c.mac.l; out[25] = c.mac.h; out[26] = c.fpul; out[27] = c.sgr;
+	for (int i = 0; i < 8; i++)
+		out[28 + i] = c.r_bank[i];
+	for (int i = 0; i < 16; i++)
+		memcpy(&out[36 + i], &c.fr[i], 4);
+}
+
+/* PC sampling profiler: every `period` SH4 cycles record the PC (and PR). */
+static int dbg_prof_id = -1;
+static int dbg_prof_period;
+static std::vector<u32> dbg_prof_samples;
+static int dbg_prof_cb(int tag, int cycles, int jitter, void *arg)
+{
+	if (dbg_prof_samples.size() < 4000000) {
+		dbg_prof_samples.push_back(Sh4cntx.pc);
+		dbg_prof_samples.push_back(Sh4cntx.pr);
+	}
+	return dbg_prof_period;
+}
+extern "C" RETRO_API void retro_dbg_prof(int period)
+{
+	if (dbg_prof_id < 0)
+		dbg_prof_id = sh4_sched_register(0, dbg_prof_cb);
+	dbg_prof_period = period;
+	sh4_sched_request(dbg_prof_id, period > 0 ? period : -1);
+}
+extern "C" RETRO_API int retro_dbg_prof_read(u32 *out, int max)
+{
+	int n = (int)std::min<size_t>(dbg_prof_samples.size(), (size_t)max);
+	memcpy(out, dbg_prof_samples.data(), n * 4);
+	dbg_prof_samples.clear();
+	return n;
+}
